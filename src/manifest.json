{
  "manifest_version": 3,
  "name": "Observable Themes",
  "version": "0.2.0",
  "description": "Themes for Observable.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://observablehq.com/*",
    "https://*.static.observableusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://observablehq.com/*",
        "https://*.static.observableusercontent.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared.css",
        "editor.css",
        "notebook.css"
      ],
      "matches": [
        "https://observablehq.com/*",
        "https://*.static.observableusercontent.com/*"
      ]
    }
  ]
}